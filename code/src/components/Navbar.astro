---
import Icon from "./Icon.astro";

const navLinks = [
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Ubicación", href: "#ubicacion" },
];
---

<header class="relative w-full bg-[var(--color-nav-bg)]">
  <div
    class="flex h-[72px] w-full items-center justify-between border-b border-[#E3C4A880] px-5 md:h-24 md:px-20"
  >
    <p class="font-heading text-[19px] font-semibold text-[var(--color-text-primary)] md:text-2xl">
      Dra. Elena Ríos
    </p>

    <nav aria-label="Principal" class="hidden items-center gap-10 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-body text-[15px] font-bold tracking-[0.2px] text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="rounded-full bg-[var(--color-text-primary)] px-6 py-2.5 font-body text-sm font-bold text-[var(--color-bg)] transition-opacity hover:opacity-90"
      >
        Contacto
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Icon name="menu" data-icon="open" class="h-6 w-6 text-[var(--color-text-primary)]" />
      <Icon name="x" data-icon="close" class="hidden h-6 w-6 text-[var(--color-text-primary)]" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden w-full border-t border-[#E3C4A880] bg-[var(--color-nav-bg)] shadow-[0_8px_24px_rgba(74,55,44,0.13)] md:hidden"
  >
    <nav aria-label="Principal móvil" class="flex flex-col px-5 pt-1 pb-7">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="flex items-center justify-between border-b border-[#E3C4A860] py-4 font-body text-base font-bold text-[var(--color-text-secondary)]"
          >
            {link.label}
            <Icon name="chevron-right" class="h-[18px] w-[18px] text-[var(--color-text-secondary)]" />
          </a>
        ))
      }
      <a
        href="#contacto"
        class="mt-3 flex w-full items-center justify-center rounded-full bg-[var(--color-text-primary)] py-3.5 font-body text-[15px] font-bold text-[var(--color-bg)]"
      >
        Contacto
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = toggle?.querySelector('[data-icon="open"]');
  const iconClose = toggle?.querySelector('[data-icon="close"]');

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
    menu?.classList.toggle("hidden", isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });
</script>
