---
import Icon from "./Icon.astro";

const navLinks = [
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Ubicación", href: "#ubicacion" },
];
---

<header class="sticky top-0 z-50 w-full bg-[var(--color-nav-bg)]">
  <div class="navbar-bar flex h-[72px] w-full items-center justify-between border-b border-[#E3C4A880] px-5">
    <p class="navbar-brand font-heading text-[19px] font-semibold text-[var(--color-text-primary)]">
      Dra. Elena Ríos
    </p>

    <nav aria-label="Principal" class="navbar-links hidden items-center md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="navbar-link font-body text-[15px] font-bold tracking-[0.2px] text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="navbar-contact rounded-full bg-[var(--color-text-primary)] px-6 py-2.5 font-body text-sm font-bold text-[var(--color-bg)] transition-opacity hover:opacity-90"
      >
        Contacto
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Icon name="menu" data-icon="open" class="h-6 w-6 text-[var(--color-text-primary)]" />
      <Icon name="x" data-icon="close" class="hidden h-6 w-6 text-[var(--color-text-primary)]" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden w-full border-t border-[#E3C4A880] bg-[var(--color-nav-bg)] shadow-[0_8px_24px_rgba(74,55,44,0.13)] md:hidden"
  >
    <nav aria-label="Principal móvil" class="flex flex-col px-5 pt-1 pb-7">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="flex items-center justify-between border-b border-[#E3C4A860] py-4 font-body text-base font-bold text-[var(--color-text-secondary)]"
          >
            {link.label}
            <Icon name="chevron-right" class="h-[18px] w-[18px] text-[var(--color-text-secondary)]" />
          </a>
        ))
      }
      <a
        href="#contacto"
        class="mt-3 flex w-full items-center justify-center rounded-full bg-[var(--color-text-primary)] py-3.5 font-body text-[15px] font-bold text-[var(--color-bg)]"
      >
        Contacto
      </a>
    </nav>
  </div>
</header>

<style>
  /* See Hero.astro for the fluid-zone rationale (768–1280px, pinned to the
     original desktop values at 1280+, nothing changes below 768). */
  @media (min-width: 768px) {
    .navbar-bar {
      height: clamp(64px, calc(10.7px + 6.67vw), 96px);
      padding-inline: clamp(32px, calc(-48px + 10vw), 80px);
    }

    .navbar-brand {
      font-size: clamp(19px, calc(10.67px + 1.042vw), 24px);
    }

    .navbar-links {
      gap: clamp(20px, calc(-13.3px + 4.167vw), 40px);
    }

    .navbar-link {
      font-size: clamp(13px, calc(9.67px + 0.4167vw), 15px);
    }

    .navbar-contact {
      padding-inline: clamp(14px, calc(-2.67px + 2.083vw), 24px);
      padding-block: clamp(7px, calc(2px + 0.625vw), 10px);
      font-size: clamp(12px, calc(8.67px + 0.4167vw), 14px);
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = toggle?.querySelector('[data-icon="open"]');
  const iconClose = toggle?.querySelector('[data-icon="close"]');

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
    menu?.classList.toggle("hidden", isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });
</script>
