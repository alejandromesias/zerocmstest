---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import portrait from "../assets/psico2.png";

const subtextDesktop = await getEntry("hero", "subtext-desktop");
const subtextMobile = await getEntry("hero", "subtext-mobile");

if (!subtextDesktop || !subtextMobile) {
  throw new Error("Missing hero subtext content collection entries");
}
---

<section class="relative overflow-hidden bg-[var(--color-bg)]">
  <div
    class="hero-blob-sage absolute -top-[90px] -left-[90px] h-[240px] w-[240px] rounded-full bg-[var(--color-accent-sage)] opacity-[0.18]"
  >
  </div>
  <div
    class="hero-blob-ring absolute top-[20px] left-[300px] h-[60px] w-[60px] rounded-full border-[7px] border-[var(--color-accent-terracotta)] opacity-50"
  >
  </div>

  <div class="hero-shell relative mx-auto flex flex-col items-center gap-7 px-7 py-14 md:flex-row md:items-center md:py-0">
    <div class="hero-portrait relative order-1 h-[320px] w-[260px] shrink-0 md:order-2 md:h-full">
      <div
        class="hero-portrait-blob absolute top-[-20px] left-[35px] h-[190px] w-[190px] rounded-full bg-[var(--color-accent-sage)] opacity-30"
      >
      </div>
      <Image
        src={portrait}
        alt="Retrato de la Dra. Elena Ríos"
        width={420}
        height={560}
        class="hero-portrait-img absolute top-[10px] left-[20px] h-[300px] w-[220px] rounded-t-[110px] object-cover shadow-[0_10px_24px_rgba(74,55,44,0.2)] md:shadow-[0_18px_40px_rgba(74,55,44,0.2)]"
      />
      <div
        class="hero-portrait-dot absolute top-[15px] left-[225px] h-3.5 w-3.5 rounded-full bg-[var(--color-accent-clay)] opacity-90"
      >
      </div>
    </div>

    <div
      class="order-2 flex w-full flex-col items-center gap-7 text-center md:order-1 md:h-full md:w-full md:items-start md:justify-center md:gap-7 md:text-left"
    >
      <p class="hero-eyebrow font-body text-[11px] font-bold tracking-[1.5px] text-[var(--color-accent-sage)]">
        PSICÓLOGA CLÍNICA
      </p>

      <div class="flex flex-col items-center gap-0.5 md:items-start md:gap-1">
        <p class="hero-headline-line font-heading text-[32px] leading-tight font-light text-[var(--color-text-primary)] italic">
          La sanación comienza
        </p>
        <p class="hero-headline-line font-heading text-[32px] leading-tight font-bold text-[var(--color-text-primary)]">
          cuando te escuchan.
        </p>
      </div>

      <p class="hero-subtext hidden w-full max-w-[460px] font-body leading-[1.55] text-[var(--color-text-secondary)] md:block md:text-left">
        {subtextDesktop.body?.trim()}
      </p>
      <p class="w-[300px] font-body text-[15px] leading-[1.5] text-[var(--color-text-secondary)] md:hidden">
        {subtextMobile.body?.trim()}
      </p>

      <div class="hero-cta flex flex-col items-center gap-3.5 md:flex-row">
        <a
          href="#agendar"
          class="hero-btn-primary rounded-full bg-[var(--color-text-primary)] px-7 py-3.5 font-body text-sm font-semibold text-[var(--color-bg)] transition-opacity hover:opacity-90"
        >
          Agendar una sesión
        </a>
        <a
          href="#saber-mas"
          class="hero-link-secondary flex items-center gap-1.5 font-body text-sm font-semibold text-[var(--color-accent-terracotta)] hover:underline"
        >
          Saber más
          <Icon name="arrow-right" class="hero-icon-arrow h-[15px] w-[15px]" />
        </a>
      </div>

      <p class="hero-trust hidden font-body text-[13px] text-[var(--color-text-secondary)] italic md:block md:text-left">
        Actualmente aceptando nuevos pacientes — en línea y presencial.
      </p>
      <p class="font-body text-xs text-[var(--color-text-secondary)] italic md:hidden">
        Aceptando nuevos pacientes, en línea y presencial.
      </p>
    </div>
  </div>
</section>

<style>
  /*
    Fluid zone: viewport 768–1280px. Below 768 the mobile stacked layout owns
    its own fixed values (untouched). At/above 1280 every clamp() is pinned to
    its max, which is exactly the original desktop design's pixel values (the
    already-approved 1440 look), so nothing changes there. In between, every
    dimension interpolates linearly with viewport width so the desktop layout
    compresses smoothly instead of overflowing between ~800–1100px.
  */
  @media (min-width: 768px) {
    .hero-shell {
      height: clamp(460px, calc(-40px + 62.5vw), 760px);
      gap: clamp(28px, calc(-25.3px + 6.67vw), 60px);
      padding-inline: clamp(32px, calc(-48px + 10vw), 80px);
      padding-block: 0;
    }

    .hero-blob-sage {
      top: clamp(-180px, calc(33.3px - 16.67vw), -100px);
      left: clamp(-160px, calc(26.7px - 14.58vw), -90px);
      height: clamp(260px, calc(-106.7px + 45.83vw), 480px);
      width: clamp(260px, calc(-106.7px + 45.83vw), 480px);
    }

    .hero-blob-ring {
      top: clamp(380px, calc(-86.7px + 58.33vw), 660px);
      left: clamp(16px, calc(-7.3px + 2.92vw), 30px);
      height: clamp(50px, calc(-16.7px + 8.33vw), 90px);
      width: clamp(50px, calc(-16.7px + 8.33vw), 90px);
      border-width: clamp(6px, calc(-0.67px + 0.833vw), 10px);
    }

    .hero-portrait {
      width: clamp(300px, calc(-133.3px + 54.17vw), 560px);
    }

    .hero-portrait-blob {
      top: clamp(-40px, calc(8px - 3.75vw), -22px);
      left: clamp(48px, calc(-22px + 8.75vw), 90px);
      height: clamp(200px, calc(-100px + 37.5vw), 380px);
      width: clamp(200px, calc(-100px + 37.5vw), 380px);
    }

    .hero-portrait-img {
      top: clamp(54px, calc(-22.7px + 9.58vw), 100px);
      left: clamp(38px, calc(-15.3px + 6.67vw), 70px);
      height: clamp(300px, calc(-133.3px + 54.17vw), 560px);
      width: clamp(220px, calc(-113.3px + 41.67vw), 420px);
      border-top-left-radius: clamp(110px, calc(-56.7px + 20.83vw), 210px);
      border-top-right-radius: clamp(110px, calc(-56.7px + 20.83vw), 210px);
    }

    .hero-portrait-dot {
      top: clamp(64px, calc(-29.3px + 11.67vw), 120px);
      left: clamp(248px, calc(-105.3px + 44.17vw), 460px);
      height: clamp(11px, calc(-4px + 1.875vw), 20px);
      width: clamp(11px, calc(-4px + 1.875vw), 20px);
    }

    .hero-eyebrow {
      font-size: clamp(10px, calc(5px + 0.625vw), 13px);
      letter-spacing: clamp(1.2px, calc(-0.13px + 0.1667vw), 2px);
    }

    .hero-headline-line {
      font-size: clamp(34px, calc(-6px + 5vw), 58px);
    }

    .hero-subtext {
      font-size: clamp(14px, calc(9px + 0.625vw), 17px);
    }

    .hero-cta {
      gap: clamp(14px, calc(-2.67px + 2.083vw), 24px);
    }

    .hero-btn-primary {
      padding-inline: clamp(20px, 2.5vw, 32px);
      padding-block: clamp(11px, calc(2.67px + 1.042vw), 16px);
      font-size: clamp(13px, calc(9.67px + 0.4167vw), 15px);
    }

    .hero-link-secondary {
      font-size: clamp(13px, calc(9.67px + 0.4167vw), 15px);
    }

    .hero-icon-arrow {
      height: clamp(13px, calc(8px + 0.625vw), 16px);
      width: clamp(13px, calc(8px + 0.625vw), 16px);
    }

    .hero-trust {
      font-size: clamp(11px, calc(7.67px + 0.4167vw), 13px);
    }
  }
</style>
